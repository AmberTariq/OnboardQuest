# -- Server --------------------------------------------------------------------
NODE_ENV=production
PORT=3001

# CORS: set to your Vercel deployment URL in production (leave blank if same-origin)
# CLIENT_ORIGIN=https://your-app.vercel.app

# -- GitHub (optional — increases rate limit for public repo analysis) ----------
# GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# -- AI provider — set ONE of the two blocks below -----------------------------

# Option A: IBM watsonx.ai
# WATSONX_API_KEY=your-ibm-cloud-api-key
# WATSONX_PROJECT_ID=your-watsonx-project-id
# WATSONX_URL=https://us-south.ml.cloud.ibm.com   # default, change region if needed
# WATSONX_MODEL_ID=ibm/granite-3-8b-instruct       # default

# Option B: OpenAI
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx
# OPENAI_MODEL=gpt-4o-mini                         # default
