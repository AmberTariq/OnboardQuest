# ── Server ─────────────────────────────────────────────────────────────────────
PORT=3001
CLIENT_ORIGIN=http://localhost:5173

# ── IBM watsonx.ai (priority 1 LLM — copy from IBM Cloud project) ────────────
# WATSONX_API_KEY=your-ibm-cloud-api-key-here
# WATSONX_PROJECT_ID=your-watsonx-project-id-here
# WATSONX_URL=https://us-south.ml.cloud.ibm.com
# WATSONX_MODEL_ID=ibm/granite-3-8b-instruct

# ── OpenAI (priority 2 LLM — used if WATSONX_API_KEY is not set) ─────────────
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# ── GitHub (optional — for private repo analysis) ─────────────────────────────
# GITHUB_TOKEN=ghp_...

# NOTE: Rename this file to .env and fill in values before running.
# Never commit .env — it is in .gitignore.
